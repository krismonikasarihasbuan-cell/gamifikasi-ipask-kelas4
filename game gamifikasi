function updateStage() {
  const g = gameState.growth;
  let idx = 0;
  for (let i = STAGES.length - 1; i >= 0; i--) {
    if (g >= STAGES[i].pct) { idx = i; break; }
  }
  gameState.stageIndex = idx;
  stageLabel.textContent = `Tahap ${idx + 1}: ${STAGES[idx].name} ${STAGES[idx].emoji}`;
  progressFill.style.width = g + "%";
  progressPct.textContent = Math.round(g) + "%";
}

function renderQuestion() {
  const q = QUESTIONS[gameState.currentQ];
  qNumberEl.textContent = `Soal ${gameState.currentQ + 1} dari ${QUESTIONS.length}`;
  qTextEl.textContent = q.q;
  optionsEl.innerHTML = "";
  feedbackEl.className = "feedback";
  feedbackEl.textContent = "";
  gameState.answered = false;

  const letters = ["A", "B", "C", "D"];
  q.options.forEach((opt, i) => {
    const btn = document.createElement("button");
    btn.className = "option-btn";
    btn.innerHTML = `<span class="option-letter">${letters[i]}</span><span>${opt}</span>`;
    btn.addEventListener("click", () => handleAnswer(i, btn));
    optionsEl.appendChild(btn);
  });
}

function handleAnswer(index, btn) {
  if (gameState.answered) return;
  gameState.answered = true;

  const q = QUESTIONS[gameState.currentQ];
  const allBtns = optionsEl.querySelectorAll(".option-btn");
  allBtns.forEach(b => b.disabled = true);

  if (index === q.answer) {
    btn.classList.add("correct");
    feedbackEl.className = "feedback show good";
    feedbackEl.textContent = "✅ Benar! Tanamanmu tumbuh! 🌱";
    // Naikkan growth
    gameState.growth = Math.min(100, gameState.growth + 20);
    updateStage();

    setTimeout(() => {
      if (gameState.currentQ < QUESTIONS.length - 1) {
        gameState.currentQ++;
        renderQuestion();
      } else {
        // Selesai semua soal
        finishGame();
      }
    }, 1200);
  } else {
    btn.classList.add("wrong");
    allBtns[q.answer].classList.add("correct");
    feedbackEl.className = "feedback show bad";
    feedbackEl.textContent = "❌ Salah! Tanaman tidak tumbuh. Coba lagi ya!";
    // Reset growth ke 0
    setTimeout(() => {
      resetGame();
    }, 1500);
  }
}

